{
  "name": "xray-qbrute-web",
  "description": "Browser frontend for the xray-qbrute WASM searcher",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sn0wo2/xray-qbrute.git",
    "directory": "Frontend"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "overrides": {
    "@napi-rs/wasm-runtime": "1.2.1",
    "source-map-js": "1.2.2"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild"
  ],
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "check": "vue-tsc --noEmit",
    "build": "vite build",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "security": "bun audit --registry=https://registry.npmjs.org",
    "ci": "bun run lint && bun run check && bun run build && bun run security"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@m234/nerd-fonts": "^0.5.2",
    "@teal-ink/vue": "^0.1.1",
    "coi-serviceworker": "^0.1.7",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^24",
    "@vitejs/plugin-vue": "^6.0.10",
    "esbuild": "^0.28.2",
    "sass": "^1.106.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}
